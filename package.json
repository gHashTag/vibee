{
  "name": "vibee",
  "description": "Project starter for elizaOS",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "project",
    "elizaos"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/cli": "1.6.5",
    "@elizaos/client": "1.6.4",
    "@elizaos/core": "1.6.5",
    "@elizaos/plugin-bootstrap": "1.6.4",
    "@elizaos/plugin-ollama": "^1.2.4",
    "@elizaos/plugin-openrouter": "^1.5.15",
    "@elizaos/plugin-sql": "1.6.4",
    "@elizaos/plugin-telegram": "^1.6.2",
    "@elizaos/plugin-tts": "^0.25.6-alpha.1",
    "@elizaos/server": "1.6.4",
    "@fal-ai/client": "^1.7.2",
    "@fal-ai/serverless-client": "^0.15.0",
    "@infisical/sdk": "^4.0.6",
    "@tanstack/react-query": "^5.29.0",
    "@types/uuid": "^11.0.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.10",
    "training": "^1.0.1",
    "uuid": "^13.0.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "jsdom": "^25.0.0",
    "prettier": "3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8",
    "vitest-sonar-reporter": "^2.0.0"
  },
  "scripts": {
    "start": "bash scripts/start-single.sh",
    "stop": "bash scripts/stop.sh",
    "dev": "bun scripts/dev.ts",
    "dev:old": "node start.mjs dev",
    "build": "bun run build.ts",
    "build:snapshot": "bun run build:ts && bun run build:snapshot-creategit",
    "lint": "prettier --write ./src",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:snapshots": "vitest run tests/snapshots/",
    "test:all": "vitest run tests/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run tests/unit/ --coverage",
    "test:coverage:integration": "vitest run tests/integration/ --coverage",
    "test:coverage:e2e": "vitest run tests/e2e/ --coverage",
    "test:coverage:report": "vitest run --coverage && bun run test:coverage:generate",
    "test:coverage:generate": "tsx tests/coverage/coverage-report.ts",
    "test:providers": "vitest run tests/unit/providers/",
    "test:plugins": "vitest run tests/unit/plugin-core.test.ts",
    "test:commands": "vitest run tests/unit/commands/",
    "test:scenes": "vitest run tests/unit/scenes/",
    "test:failover": "vitest run tests/integration/provider-failover.test.ts",
    "test:workflow": "vitest run tests/e2e/full-workflow.test.ts",
    "test:ci": "vitest run tests/unit/ tests/integration/ --reporter=verbose",
    "test:ci:coverage": "vitest run tests/ --coverage --reporter=verbose",
    "test:quick": "vitest run tests/unit/ --reporter=dot",
    "test:auto": "bun scripts/test-bot-auto.ts",
    "test:component": "vitest run tests/component/",
    "test:install": "node scripts/install-test-deps.js",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "check-all": "bun run type-check && bun run format:check && bun run test:all",
    "check:coverage": "bun run test:coverage && bun run test:coverage:generate && bun run test:coverage:verify",
    "test:provider": "vitest run tests/unit/providers/*.test.ts",
    "cy:open": "bun run test:install && cypress open",
    "cy:run": "bun run test:install && cypress run --component",
    "cy:test": "bun run test:install && cypress run --component --reporter spec",
    "cypress:component": "bun run test:install && cypress run --component",
    "cypress:e2e": "bun run test:install && cypress run --e2e",
    "cypress:open": "bun run test:install && cypress open",
    "build:watch": "bun run build.ts --watch",
    "build:snapshot-creategit": "bun scripts/create-git-snapshot.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "b165ad83e5f7a21bc1edbd83374ca087e3cd6b33"
}