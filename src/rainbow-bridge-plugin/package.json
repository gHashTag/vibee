{
  "name": "@elizaos/plugin-rainbow-bridge",
  "version": "1.0.0",
  "description": "🌈 Autonomous E2E testing plugin for Telegram bots via real bot interaction. Test your bot like a user would, automatically.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "elizaos",
    "plugin",
    "testing",
    "e2e",
    "telegram",
    "autonomous",
    "qa",
    "automation",
    "rainbow-bridge"
  ],
  "author": {
    "name": "Vibee Team",
    "url": "https://github.com/playra/vibee"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playra/vibee.git",
    "directory": "src/rainbow-bridge-plugin"
  },
  "bugs": {
    "url": "https://github.com/playra/vibee/issues"
  },
  "homepage": "https://github.com/playra/vibee/tree/main/src/rainbow-bridge-plugin#readme",
  "scripts": {
    "build": "tsup && tsc",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python3 scripts/rainbow-bridge-test.py critical",
    "lint": "prettier --write ./src",
    "clean": "rm -rf dist .turbo node_modules .turbo-tsconfig.json tsconfig.tsbuildinfo",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "@elizaos/core": "^1.6.2"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "prettier": "3.5.3",
    "tsup": "8.4.0",
    "typescript": "^5.8.3",
    "vitest": "1.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "TELEGRAM_API_ID": {
        "type": "string",
        "description": "Telegram API ID for user authentication (get from https://my.telegram.org/apps)",
        "required": true,
        "sensitive": true
      },
      "TELEGRAM_API_HASH": {
        "type": "string",
        "description": "Telegram API Hash for user authentication",
        "required": true,
        "sensitive": true
      },
      "TELEGRAM_SESSION_STRING": {
        "type": "string",
        "description": "Telegram session string for autonomous operation (generated by auth script)",
        "required": true,
        "sensitive": true
      },
      "RAINBOW_BRIDGE_BOT_USERNAME": {
        "type": "string",
        "description": "Bot username to test (e.g., 'agent_vibecoder_bot')",
        "required": false,
        "sensitive": false
      },
      "RAINBOW_BRIDGE_ENABLED": {
        "type": "boolean",
        "description": "Enable Rainbow Bridge E2E testing",
        "required": false,
        "default": true,
        "sensitive": false
      },
      "RAINBOW_BRIDGE_AUTO_RUN": {
        "type": "boolean",
        "description": "Automatically run E2E tests on bot startup",
        "required": false,
        "default": false,
        "sensitive": false
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
