// Пример использования:
/**
 * ```typescript
 * import { configManager } from './plugins/core';
 *
 * // Загрузить конфигурацию плагина
 * const config = await configManager.loadConfig('neuro-photo');
 *
 * // Проверить, включен ли плагин
 * if (configManager.isPluginEnabled('kie-ai-provider')) {
 *   // ...
 * }
 *
 * // Валидировать все плагины
 * const results = await configManager.validateAll();
 * results.forEach(result => {
 *   if (!result.valid) {
 *     console.error(`Ошибка в ${result.pluginName}:`, result.errors);
 *   }
 * });
 * ```
 */
