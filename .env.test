# Test Environment Configuration
# This file is for automated testing only
# DO NOT use production credentials here

# Test Mode (must be true for testing)
NODE_ENV=test
TELEGRAM_DRY_RUN=true

# Test User Configuration
# Set this to your test Telegram chat ID
# You can get it by sending a message to the bot and checking logs
TEST_TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=debug

# Database (use separate test database)
DATABASE_URL=sqlite://./data/test.db

# Timeouts for testing
TEST_TIMEOUT=30000
TEST_RESPONSE_TIMEOUT=15000

# Test Features
ENABLE_TEST_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true
